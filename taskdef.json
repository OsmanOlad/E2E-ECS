{
    "family": "e2e-ecs-dev-task",
    "networkMode": "awsvpc",
    "executionRoleArn": "arn:aws:iam::446781112519:role/e2e-ecs-dev-ecs-task-execution-role",
    "taskRoleArn": "arn:aws:iam::446781112519:role/e2e-ecs-dev-ecs-task-role",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "containerDefinitions": [
        {
            "name": "url-shortener",
            "image": "446781112519.dkr.ecr.eu-west-2.amazonaws.com/e2e-ecs-dev-repo:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/e2e-ecs-dev-app",
                    "awslogs-region": "eu-west-2",
                    "awslogs-stream-prefix": "ecs"
                }
            },
           "environment": [
                { "name": "TABLE_NAME", "value": "e2e-ecs-dev-urls" }
            ]
        }
    ]
}
